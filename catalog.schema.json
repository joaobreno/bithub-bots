{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catálogo de bots do Bithub",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "bots"],
  "properties": {
    "schemaVersion": {"const": 1},
    "bots": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/bot"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 80},
    "skill": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "description", "content"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 1000},
        "content": {"type": "string", "minLength": 1, "maxLength": 30000}
      }
    },
    "bot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "name", "description", "category", "author", "avatarSeed", "featured", "tags", "instructions", "skills"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 64},
        "name": {"type": "string", "minLength": 1, "maxLength": 200},
        "description": {"type": "string", "minLength": 1, "maxLength": 4000},
        "category": {"enum": ["programacao", "produtividade", "pesquisa", "escrita", "planejamento"]},
        "author": {"type": "string", "minLength": 1, "maxLength": 100},
        "avatarSeed": {"type": "string", "pattern": "^bit:[0-7]:[0-3](?::(?:1[0-8]|[0-9]))?$"},
        "featured": {"type": "boolean"},
        "tags": {"type": "array", "maxItems": 12, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
        "instructions": {"type": "string", "minLength": 1, "maxLength": 40000},
        "skills": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/skill"}}
      }
    }
  },
  "$comment": "Os limites de texto também são validados em bytes UTF-8 pelo gerador e pelo Bithub; JSON Schema mede caracteres."
}
